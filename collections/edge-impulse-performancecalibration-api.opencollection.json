{
  "opencollection": "1.0.0",
  "info": {
    "name": "Edge Impulse PerformanceCalibration API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "PerformanceCalibration",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://studio.edgeimpulse.com/v1/api/:projectId/performance-calibration/status",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "impulseId",
                "value": "",
                "type": "query",
                "description": "Impulse ID. If this is unset then the default impulse is used."
              }
            ]
          },
          "docs": "Get performance calibration status"
        },
        {
          "info": {
            "name": "Get ground truth",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://studio.edgeimpulse.com/v1/api/:projectId/performance-calibration/ground-truth",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "impulseId",
                "value": "",
                "type": "query",
                "description": "Impulse ID. If this is unset then the default impulse is used."
              }
            ]
          },
          "docs": "Get performance calibration ground truth data"
        },
        {
          "info": {
            "name": "Get raw result",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://studio.edgeimpulse.com/v1/api/:projectId/performance-calibration/raw-result",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "impulseId",
                "value": "",
                "type": "query",
                "description": "Impulse ID. If this is unset then the default impulse is used."
              }
            ]
          },
          "docs": "Get performance calibration raw result"
        },
        {
          "info": {
            "name": "Get parameter sets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://studio.edgeimpulse.com/v1/api/:projectId/performance-calibration/parameter-sets",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "impulseId",
                "value": "",
                "type": "query",
                "description": "Impulse ID. If this is unset then the default impulse is used."
              }
            ]
          },
          "docs": "Get performance calibration parameter sets"
        },
        {
          "info": {
            "name": "Get parameters",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://studio.edgeimpulse.com/v1/api/:projectId/performance-calibration/parameters",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "impulseId",
                "value": "",
                "type": "query",
                "description": "Impulse ID. If this is unset then the default impulse is used."
              }
            ]
          },
          "docs": "Get performance calibration stored parameters"
        },
        {
          "info": {
            "name": "Save performance calibration parameters",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://studio.edgeimpulse.com/v1/api/:projectId/performance-calibration/parameters",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "impulseId",
                "value": "",
                "type": "query",
                "description": "Impulse ID. If this is unset then the default impulse is used."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Set the current performance calibration parameters"
        },
        {
          "info": {
            "name": "Clear performance calibration parameters",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://studio.edgeimpulse.com/v1/api/:projectId/performance-calibration/parameters",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "impulseId",
                "value": "",
                "type": "query",
                "description": "Impulse ID. If this is unset then the default impulse is used."
              }
            ]
          },
          "docs": "Clears the current performance calibration parameters"
        },
        {
          "info": {
            "name": "Get WAV file",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://studio.edgeimpulse.com/v1/api/:projectId/performance-calibration/wav",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "impulseId",
                "value": "",
                "type": "query",
                "description": "Impulse ID. If this is unset then the default impulse is used."
              }
            ]
          },
          "docs": "Get the synthetic sample as a WAV file"
        },
        {
          "info": {
            "name": "Upload Performance Calibration Audio files",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://studio.edgeimpulse.com/v1/api/:projectId/performance-calibration/files",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "impulseId",
                "value": "",
                "type": "query",
                "description": "Impulse ID. If this is unset then the default impulse is used."
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": []
            }
          },
          "docs": "Upload a zip files with a wav file and its Label metadata to run performance calibration on it."
        },
        {
          "info": {
            "name": "Clear Performance Calibration state",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://studio.edgeimpulse.com/v1/api/:projectId/performance-calibration/clear",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "impulseId",
                "value": "",
                "type": "query",
                "description": "Impulse ID. If this is unset then the default impulse is used."
              }
            ]
          },
          "docs": "Deletes all state related to performance calibration (used in tests for example)."
        },
        {
          "info": {
            "name": "Get post processing results",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://studio.edgeimpulse.com/v1/api/:projectId/post-processing/results",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "impulseId",
                "value": "",
                "type": "query",
                "description": "Impulse ID. If this is unset then the default impulse is used."
              }
            ]
          },
          "docs": "Get results of most recent post processing run"
        }
      ]
    }
  ],
  "bundled": true
}