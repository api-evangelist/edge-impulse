            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://studio.edgeimpulse.com/v1/api/organizations/:organizationId/buckets",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path",
                "description": "Organization ID"
              }
            ]
          },
          "docs": "Retrieve all configured storage buckets. This does not list the secret key."
        },
        {
          "info": {
            "name": "Add a storage bucket",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://studio.edgeimpulse.com/v1/api/organizations/:organizationId/buckets",
            "params": [
              {
                "name": "organizationId",
