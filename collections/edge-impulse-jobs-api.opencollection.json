{
  "opencollection": "1.0.0",
  "info": {
    "name": "Edge Impulse Jobs API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
