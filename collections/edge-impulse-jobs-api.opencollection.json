            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Do a dry-run of an AI Actions job over a subset of data. This will instruct the block to propose changes to data items (via \"setSampleProposedChanges\") rather than apply the changes directly."
        },
        {
          "info": {
            "name": "Create AI Actions job",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://studio.edgeimpulse.com/v1/api/:projectId/jobs/ai-actions/:actionId",
