                "name": "actionId",
                "value": "",
                "type": "path",
                "description": "AI Action ID"
              }
            ]
          },
          "docs": "Run an AI Actions job over a subset of data. This will instruct the block to apply the changes directly to your dataset. To preview, use \"createPreviewAIActionsJob\". To set the config use `updateAIAction`."
