{
  "opencollection": "1.0.0",
  "info": {
    "name": "Edge Impulse Metrics API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Metrics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get public metrics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://studio.edgeimpulse.com/v1/api-metrics"
          },
          "docs": "Get information about number of projects, compute and data samples. Updated once per hour."
        },
        {
          "info": {
            "name": "Log website pageview",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://studio.edgeimpulse.com/v1/api-metrics/website/pageviews",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Log a website pageview. Used for website analytics."
        },
        {
          "info": {
            "name": "Log analytics event",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://studio.edgeimpulse.com/v1/api-metrics/events",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Log an analytics event."
        }
      ]
    }
  ],
  "bundled": true
}